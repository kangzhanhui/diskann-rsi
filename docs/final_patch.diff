+        // A larger ratio keeps the search going.
+        assert!(!queue.should_stop_early(3, 3.0, 2, 2));
+        // A larger k keeps the search going (k-th distance is 6.0 at k=6).
+        assert!(!queue.should_stop_early(6, 1.0, 2, 2));
+        // Once the whole window is visited there is nothing left to expand.
+        for _ in 0..5 {
+            assert!(queue.closest_notvisited().is_some());
+        }
+        assert!(!queue.should_stop_early(3, 1.0, 2, 20));
+    }
